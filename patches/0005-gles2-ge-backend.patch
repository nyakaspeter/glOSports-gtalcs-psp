+// Frames the game writes to PSP memory itself (movies, loading screens); the
+// window thread calls this. Drawn by the render thread, in order with frames.
+static bool gles2_present_guest_rgba(std::span<const std::byte> rgba, std::uint32_t width,
+                                     std::uint32_t height) noexcept {
+    Gles2State &s = state();
+    if (!s.enabled || width == 0u || height == 0u ||
+        rgba.size() < static_cast<std::size_t>(width) * height * 4u)
+        return false;
+    std::unique_ptr<Frame> frame = take_frame(s);
+    frame->guest = true;
+    frame->guest_rgba.assign(rgba.begin(), rgba.begin() + static_cast<std::ptrdiff_t>(width) * height * 4);
+    frame->guest_width = width;
+    frame->guest_height = height;
+    submit_frame(s, std::move(frame));
+    return true;
+}
