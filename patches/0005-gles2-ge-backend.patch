+bool ge_gpu_backend_upload_decoded_texture(const GeGpuDrawDescriptor &draw, std::uint32_t width,
+                                           std::uint32_t height, std::span<const std::byte> rgba) noexcept {
+    if (rgba.empty()) return false;
+    Gles2State &s = state();
