+namespace {
+
+// Appends a hardware-transform draw: fill(out) writes vertex_count vertices
+// straight into the frame's vertex array (no temporary per draw).
+template <typename Fill>
+void append_hardware_batch(Gles2State &s, const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+                           std::size_t vertex_count, std::span<const std::uint32_t> triangle_indices, Fill fill) {
+    const bool indexed = !triangle_indices.empty();
+    const std::size_t emitted = indexed ? triangle_indices.size() : vertex_count;
+    if (emitted == 0u || (transform.primitive == 4u ? emitted < 3u : (emitted % 3u) != 0u)) return;
+    if (s.vertices.size() + vertex_count > kMaxFrameVertices) {
+        ++s.report.game_vertex_overflows;
+        return;
+    }
+    if (indexed) {
+        std::uint32_t highest = 0u;
+        for (std::uint32_t index : triangle_indices) highest = std::max(highest, index);
+        if (highest >= vertex_count) {
+            ++s.report.game_vertex_overflows;
+            return;
+        }
+    }
+    const std::uint32_t first_vertex = static_cast<std::uint32_t>(s.vertices.size());
+    const std::uint32_t first_index = static_cast<std::uint32_t>(s.indices.size());
+    s.vertices.resize(first_vertex + vertex_count);
+    fill(s.vertices.data() + first_vertex);
+    if (indexed) s.indices.insert(s.indices.end(), triangle_indices.begin(), triangle_indices.end());
+    Batch &batch = s.batches.emplace_back();
+    batch.draw = draw;
+    batch.texture_key = draw.texture_enabled ? texture_key(draw) : 0u;
+    batch.first_vertex = first_vertex;
+    batch.vertex_count = static_cast<std::uint32_t>(vertex_count);
+    batch.first_index = first_index;
+    batch.index_count = indexed ? static_cast<std::uint32_t>(triangle_indices.size()) : 0u;
+    batch.indexed = indexed;
+    batch.logical_draw_count = std::max<std::uint32_t>(1u, transform.logical_prim_batches);
+    batch.hardware_transform = true;
+    batch.transform = transform;
+    batch.feedback_address = draw.texture_address & 0x001FFFF0u;
+    batch.framebuffer_feedback = draw.texture_enabled && is_target(s, batch.feedback_address);
+    s.report.game_draw_calls += batch.logical_draw_count;
+    s.report.hw_transform_draw_calls += batch.logical_draw_count;
+    s.report.game_vertices += emitted;
+}
+
+}  // namespace
+
+void ge_gpu_backend_accumulate_hardware_triangles(
+    const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+    std::span<const GeGpuVertex> vertices, std::span<const std::uint32_t> triangle_indices) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled || vertices.empty()) return;
+    append_hardware_batch(s, draw, transform, vertices.size(), triangle_indices, [&](Vertex *out) {
+        for (const GeGpuVertex &v : vertices)
+            *out++ = {v.x, v.y, v.z, v.w, v.rgba, v.u, v.v, v.q, v.fog_factor};
+    });
+}
+
+bool ge_gpu_backend_accumulate_hardware_packed_0115(
+    const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+    std::span<const std::byte> packed_vertices, std::uint32_t vertex_count,
+    std::span<const std::uint32_t> triangle_indices) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled || vertex_count == 0u ||
+        packed_vertices.size() != static_cast<std::size_t>(vertex_count) * sizeof(Packed0115))
+        return false;
+    // Kept as the PSP stores them; the vertex shader decodes them.
+    const bool indexed = !triangle_indices.empty();
+    const std::size_t emitted = indexed ? triangle_indices.size() : vertex_count;
+    if (emitted == 0u || (transform.primitive == 4u ? emitted < 3u : (emitted % 3u) != 0u)) return true;
+    if (s.packed.size() / sizeof(Packed0115) + vertex_count > kMaxFrameVertices) {
+        ++s.report.game_vertex_overflows;
+        return true;
+    }
+    if (indexed) {
+        std::uint32_t highest = 0u;
+        for (std::uint32_t index : triangle_indices) highest = std::max(highest, index);
+        if (highest >= vertex_count) {
+            ++s.report.game_vertex_overflows;
+            return true;
+        }
+    }
+    const std::uint32_t first_vertex = static_cast<std::uint32_t>(s.packed.size() / sizeof(Packed0115));
+    const std::uint32_t first_index = static_cast<std::uint32_t>(s.indices.size());
+    const auto *bytes = reinterpret_cast<const std::uint8_t *>(packed_vertices.data());
+    s.packed.insert(s.packed.end(), bytes, bytes + packed_vertices.size());
+    if (indexed) s.indices.insert(s.indices.end(), triangle_indices.begin(), triangle_indices.end());
+    Batch &batch = s.batches.emplace_back();
+    batch.draw = draw;
+    batch.texture_key = draw.texture_enabled ? texture_key(draw) : 0u;
+    batch.first_vertex = first_vertex;
+    batch.vertex_count = vertex_count;
+    batch.first_index = first_index;
+    batch.index_count = indexed ? static_cast<std::uint32_t>(triangle_indices.size()) : 0u;
+    batch.indexed = indexed;
+    batch.logical_draw_count = std::max<std::uint32_t>(1u, transform.logical_prim_batches);
+    batch.hardware_transform = true;
+    batch.packed = true;
+    batch.transform = transform;
+    batch.feedback_address = draw.texture_address & 0x001FFFF0u;
+    batch.framebuffer_feedback = draw.texture_enabled && is_target(s, batch.feedback_address);
+    s.report.game_draw_calls += batch.logical_draw_count;
+    s.report.hw_transform_draw_calls += batch.logical_draw_count;
+    s.report.game_vertices += emitted;
+    return true;
+}
