+bool ge_gpu_backend_finish_color_frame(std::uint64_t vblank) noexcept {
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    const bool publish = ge_finish_shows_this_frame();
+    if (!s.enabled || (s.batches.empty() && s.uploads.empty() && s.deletes.empty())) {
+        s.vertices.clear();
+        s.packed.clear();
+        s.indices.clear();
+        s.batches.clear();
+        ++s.frame_epoch;
+        return false;
+    }
+    evict_textures(s);
+    bool touched_display = false;
+    std::uint64_t psp_draws = 0u;
+    for (const Batch &batch : s.batches) {
+        psp_draws += batch.logical_draw_count;
+        touched_display |= (batch.draw.framebuffer_address & 0x001FFFF0u) == s.display_framebuffer;
+    }
+    std::unique_ptr<Frame> frame = take_frame(s);
+    frame->guest = false;
+    frame->vertices.swap(s.vertices);
+    frame->packed.swap(s.packed);
+    frame->indices.swap(s.indices);
+    frame->batches.swap(s.batches);
+    frame->uploads.swap(s.uploads);
+    frame->deletes.swap(s.deletes);
+    frame->targets.clear();
+    for (const auto &entry : s.targets) frame->targets.push_back(entry.second);
+    frame->display_framebuffer = s.display_framebuffer;
+    frame->display_logical_width = s.display_logical_width;
+    frame->display_logical_height = s.display_logical_height;
+    frame->publish = publish;
+    frame->display_aspect = resolve_widescreen_aspect_ratio(lcs_render_configuration(), 0u, 0u);
+    frame->psp_draws = psp_draws;
+    // The swaps left the spare frame's (empty) buffers here, capacity and all.
+    s.vertices.clear();
+    s.packed.clear();
+    s.indices.clear();
+    s.batches.clear();
+    s.uploads.clear();
+    s.deletes.clear();
+    submit_frame(s, std::move(frame));
+    ++s.report.game_frames;
+    s.report.game_frame_vblank = vblank;
+    s.report.presented_framebuffer_target = touched_display ? s.display_framebuffer : 0u;
+    if (!touched_display) ++s.report.frames_without_displayed_target;
+    ++s.frame_epoch;
+    return publish && touched_display;
+}
