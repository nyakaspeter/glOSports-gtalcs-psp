+// LCS_GLES_UPLOAD_THREAD: uploads the GE thread's decoded textures on a
+// second context sharing the render context's objects, a few at a time, then
+// glFinish: done, the render thread can bind them (it binds every texture
+// again each frame, as GLES requires for changes made in another context).
+void upload_thread_main(Gles2State *s) {
+    RenderState &r = s->render;
+    SharedTextures &t = r.shared;
+    if (eglMakeCurrent(r.display, r.upload_surface, r.upload_surface, r.upload_context) != EGL_TRUE) {
