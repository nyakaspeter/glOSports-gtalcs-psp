+// Uploads a decoded texture into a new texture object, or with the pool on
+// into a pooled one of its shape (glTexSubImage2D, no GPU allocation), on the
+// calling thread's context (render or upload thread); leaves it bound. Same
+// levels as upload_texture: the game's, then the chain completed to 1x1 (a
+// mipmapped texture is complete). id 0: nothing to upload.
+GlTexture create_texture(SharedTextures &t, const TextureUpload &upload) {
+    GlTexture texture{};
+    const std::size_t base_bytes = static_cast<std::size_t>(upload.width) * upload.height * 4u;
+    if (upload.width == 0u || upload.height == 0u || upload.rgba8.size() < base_bytes) return texture;
+    texture.width = upload.width;
+    texture.height = upload.height;
+    texture.pot = power_of_two(upload.width) && power_of_two(upload.height);
+    const std::uint32_t levels = texture.pot ? upload.mip_levels : 1u;
+    std::uint32_t total = 1u;  // the levels the texture ends up with
+    if (levels > 1u)
+        for (std::uint32_t w = upload.width, h = upload.height; w > 1u || h > 1u; ++total) {
+            w = std::max(1u, w >> 1u);
+            h = std::max(1u, h >> 1u);
+        }
+    if (t.pool_enabled) texture.id = take_pooled_texture(t, upload.width, upload.height, total);
+    const bool allocate = texture.id == 0u;
+    if (allocate) {
+        glGenTextures(1, &texture.id);
+        ++t.allocations;
+    } else {
+        ++t.pool_hits;
+    }
+    glBindTexture(GL_TEXTURE_2D, texture.id);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    const auto level_image = [&](std::uint32_t level, std::uint32_t width, std::uint32_t height, const void *pixels) {
+        if (allocate)
+            glTexImage2D(GL_TEXTURE_2D, static_cast<GLint>(level), GL_RGBA, static_cast<GLsizei>(width),
+                         static_cast<GLsizei>(height), 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+        else
+            glTexSubImage2D(GL_TEXTURE_2D, static_cast<GLint>(level), 0, 0, static_cast<GLsizei>(width),
+                            static_cast<GLsizei>(height), GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+    };
+    std::uint32_t width = upload.width;
+    std::uint32_t height = upload.height;
+    std::size_t offset = 0u;
+    std::uint32_t uploaded = 0u;
+    const std::byte *last = nullptr;
+    std::uint32_t last_width = 0u;
+    std::uint32_t last_height = 0u;
+    while (uploaded < levels) {
+        const std::size_t level_bytes = static_cast<std::size_t>(width) * height * 4u;
+        if (offset + level_bytes > upload.rgba8.size()) break;
+        last = upload.rgba8.data() + offset;
+        level_image(uploaded, width, height, last);
+        offset += level_bytes;
+        last_width = width;
+        last_height = height;
+        ++uploaded;
+        if (width == 1u && height == 1u) break;
+        width = std::max(1u, width >> 1u);
+        height = std::max(1u, height >> 1u);
+    }
+    if (levels > 1u) {
+        std::vector<std::byte> generated;
+        while (!(last_width == 1u && last_height == 1u)) {
+            generated = half_size(last, last_width, last_height);
+            last_width = std::max(1u, last_width >> 1u);
+            last_height = std::max(1u, last_height >> 1u);
+            level_image(uploaded, last_width, last_height, generated.data());
+            last = generated.data();
+            ++uploaded;
+        }
+    }
