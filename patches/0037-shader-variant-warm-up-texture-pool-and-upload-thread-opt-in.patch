+// A texture object to the pool (render thread): reusable once the frames that
+// may still sample it are done; the oldest go past the pool's bounds.
+void pool_texture(SharedTextures &t, const GlTexture &texture) {
+    std::size_t bytes = 0u;
+    for (std::uint32_t level = 0u; level < texture.mip_levels; ++level)
+        bytes += static_cast<std::size_t>(std::max(1u, texture.width >> level)) *
+                 std::max(1u, texture.height >> level) * 4u;
+    std::vector<GLuint> evicted;
+    {
+        std::lock_guard<std::mutex> lock(t.pool_mutex);
+        t.pool.push_back({texture.id, texture.width, texture.height, texture.mip_levels, bytes,
+                          t.render_frames.load() + kPoolReuseFrames});
+        t.pool_bytes += bytes;
+        while (t.pool.size() > kPoolMaxTextures || t.pool_bytes > kPoolMaxBytes) {
+            evicted.push_back(t.pool.front().id);
+            t.pool_bytes -= t.pool.front().bytes;
+            t.pool.pop_front();
+        }
+    }
+    if (!evicted.empty()) glDeleteTextures(static_cast<GLsizei>(evicted.size()), evicted.data());
+}
+
+// A pooled texture object of this shape, or 0 (either thread).
+GLuint take_pooled_texture(SharedTextures &t, std::uint32_t width, std::uint32_t height, std::uint32_t levels) {
+    std::lock_guard<std::mutex> lock(t.pool_mutex);
+    const std::uint64_t frames = t.render_frames.load();
+    for (auto it = t.pool.begin(); it != t.pool.end(); ++it) {
+        if (it->width != width || it->height != height || it->levels != levels || it->reusable_at > frames) continue;
+        const GLuint id = it->id;
+        t.pool_bytes -= it->bytes;
+        t.pool.erase(it);
+        return id;
+    }
+    return 0u;
+}
