 constexpr std::uint32_t kMaxCommands = 2'000'000u;
 
+// Per-command class bits: most words are plain register writes and take the
+// short path. Bit 1: handled by the switch below. Bit 2: a matrix/morph word
+// (0x2A-0x41, texture matrix included). Bit 4: lighting or material state.
+// Bit 8: anything the hardware transform is built from (matrices, viewport,
+// depth clip, cull, fog range).
+constexpr std::uint8_t kSwitch = 1u, kMatrix = 2u, kLighting = 4u, kTransform = 8u;
+constexpr std::array<std::uint8_t, 256> kCommandClass = [] {
+    std::array<std::uint8_t, 256> c{};
+    for (std::uint32_t op : {0x01u, 0x02u, 0x04u, 0x08u, 0x0Au, 0x0Bu, 0x0Cu, 0x0Fu, 0x10u, 0x13u}) c[op] |= kSwitch;
+    for (std::uint32_t op = 0x2Au; op <= 0x41u; ++op) c[op] |= kMatrix;
+    for (std::uint32_t op = 0x3Au; op <= 0x3Fu; ++op) c[op] |= kTransform;
+    for (std::uint32_t op = 0x42u; op <= 0x4Du; ++op) c[op] |= kTransform;
+    for (std::uint32_t op : {0x1Cu, 0x1Du, 0x9Bu, 0xCDu, 0xCEu}) c[op] |= kTransform;
+    for (std::uint32_t op = 0x17u; op <= 0x1Bu; ++op) c[op] |= kLighting;
+    for (std::uint32_t op = 0x50u; op <= 0x5Du; ++op) c[op] |= kLighting;
+    for (std::uint32_t op = 0x5Fu; op <= 0x9Au; ++op) c[op] |= kLighting;
+    return c;
+}();
