+
+// A texture's guest bytes are re-hashed every kTextureRecheckFrames frames
+// (LCS_GLES_TEXTURE_RECHECK; 1 = every frame as before): hashing every texture
+// every frame was 3.6% of the GE thread, and a texture the game rewrites in
+// place shows up at most that many frames late.
+std::uint64_t texture_recheck_frames() noexcept {
+    static const std::uint64_t frames = [] {
+        const char *text = std::getenv("LCS_GLES_TEXTURE_RECHECK");
+        const unsigned long value = text != nullptr && *text != '\0' ? std::strtoul(text, nullptr, 10) : 4ul;
+        return static_cast<std::uint64_t>(std::clamp<unsigned long>(value, 1ul, 60ul));
+    }();
+    return frames;
 }
 
