diff --git a/lcs/CMakeLists.txt b/lcs/CMakeLists.txt
--- a/lcs/CMakeLists.txt
+++ b/lcs/CMakeLists.txt
@@ -4,6 +4,18 @@
 file(GLOB HOST_SOURCES CONFIGURE_DEPENDS host/*.cpp)
 list(REMOVE_ITEM HOST_SOURCES ${CMAKE_CURRENT_SOURCE_DIR}/host/pack_font5x7.cpp)
 add_executable(LCSNative ${HOST_SOURCES})
+# Per-file PGO retrain: the named host sources are compiled instrumented (their
+# profile dropped) while everything else keeps the profile it has. build.sh
+# sets this from PGO_FILES; pgo.sh merges the resulting .gcda files into pgo/.
+set(LCS_PGO_GENERATE_FILES "" CACHE STRING "host sources compiled -fprofile-generate for a per-file retrain")
+foreach(lcs_pgo_file ${LCS_PGO_GENERATE_FILES})
+    set_source_files_properties(${CMAKE_CURRENT_SOURCE_DIR}/host/${lcs_pgo_file}
+        PROPERTIES COMPILE_OPTIONS "-fno-profile-use;-fprofile-generate=/dev/shm/lcspgo")
+endforeach()
+if(LCS_PGO_GENERATE_FILES)
+    target_compile_definitions(LCSNative PRIVATE LCS_PGO_GENERATE)
+    target_link_options(LCSNative PRIVATE -fprofile-generate=/dev/shm/lcspgo)
+endif()
 target_include_directories(LCSNative PRIVATE host)
 # Debug info for the host code only (profiling with addr2line); package.sh strips it.
 if(NOT MSVC)
