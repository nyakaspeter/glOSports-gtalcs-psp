--- /dev/null
+++ b/lcs/host/lcs_world_clip.hpp
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <cstdlib>
+
+namespace lcs {
+
+// The game clips its world geometry itself: the PSP's graphics chip drops a
+// triangle that leaves its 4096 x 4096 drawing space instead of clipping it,
+// so for every mesh that crosses an edge of the view the game walks the
+// strip vertex by vertex (0x08A49750: int16 position to float, a 4 x 4
+// transform, four plane tests), cuts the strip at each triangle that crosses
+// a plane, clips that triangle on the CPU and draws the pieces
+// as separate primitives. A mesh wholly inside the view takes the game's
+// direct path: one strip, as stored.
+//
+// A GL driver clips every triangle against the view volume itself, so under
+// GLES 2 every mesh takes that direct path (the place that chooses, in
+// generated unit 0084, asks here): the same picture without the per-vertex
+// walk (9% of the game thread on a busy street), the CPU clipper and the
+// extra primitives. LCS_GPU_CLIP=0: the game clips, as on the PSP.
+[[nodiscard]] inline bool lcs_world_clipped_by_gpu() noexcept {
+#if defined(LCS_GLES2_GE_BACKEND)
+    static const bool enabled = [] {
+        const char *text = std::getenv("LCS_GPU_CLIP");
+        return text == nullptr || *text == '\0' || *text != '0';
+    }();
+    return enabled;
+#else
+    return false;
+#endif
+}
+
+}  // namespace lcs
