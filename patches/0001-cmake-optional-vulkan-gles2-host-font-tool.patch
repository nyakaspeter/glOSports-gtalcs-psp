-    set_source_files_properties(${CMAKE_CURRENT_SOURCE_DIR}/host/ge_gpu_backend_vulkan.cpp
-        PROPERTIES OBJECT_DEPENDS ${LCS_GE_SPV_HEADER})
     # Some linkers do not resolve the shared libraries FFmpeg itself depends on.
     # Probe a small link, and only then pass FFmpeg's own libdir as -rpath-link.
     include(CheckCXXSourceCompiles)
@@ -115,6 +149,15 @@ if(GENERATED_SOURCES)
             $<$<CONFIG:Release,RelWithDebInfo>:/O2>)
     else()
         target_compile_options(lcs_generated PRIVATE -O2)
+        # Thumb-2 conditional branches reach +-1 MB; these units' largest
+        # functions exceed that once instrumented for PGO, so they are ARM code
+        # (in every build, so the profile matches the code it is applied to).
+        if(CMAKE_SYSTEM_PROCESSOR MATCHES "^arm")
+            foreach(unit 0061 0062 0063)
+                set_source_files_properties(${CMAKE_CURRENT_SOURCE_DIR}/generated/generated_unit_${unit}.cpp
+                    PROPERTIES COMPILE_OPTIONS -marm)
+            endforeach()
+        endif()
     endif()
     target_link_libraries(LCSNative PRIVATE lcs_generated)
 else()
