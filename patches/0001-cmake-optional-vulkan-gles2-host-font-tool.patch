+        target_link_libraries(LCSNative PRIVATE PkgConfig::GLES2)
+    endif()
+endif()
+if(NOT WIN32 AND LCS_VULKAN)
+    pkg_check_modules(VULKAN REQUIRED IMPORTED_TARGET vulkan)
+    target_compile_definitions(LCSNative PRIVATE LCS_VULKAN_GE_BACKEND=1)
+    target_link_libraries(LCSNative PRIVATE PkgConfig::VULKAN)
