+    option(LCS_GLES2 "Build the GLES 2 GE backend when Vulkan is off" ON)
+    if(NOT LCS_VULKAN AND LCS_GLES2)
+        pkg_check_modules(GLES2 REQUIRED IMPORTED_TARGET egl glesv2)
