+// LCS_GLES_MIN_PIXELS=<n>: also drop a mesh whose bounding box, wholly in
+// front of the camera, projects to less than n pixels along both screen axes
+// (distant small props, far-away detail). Unset or 0: off.
+float min_pixels() {
+    static const float pixels = [] {
+        const char *text = std::getenv("LCS_GLES_MIN_PIXELS");
+        if (text == nullptr || *text == '\0') return 0.0f;
+        const float value = std::strtof(text, nullptr);
+        return std::isfinite(value) && value > 0.0f ? value : 0.0f;
+    }();
+    return pixels;
 }
 
