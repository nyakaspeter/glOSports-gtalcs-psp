+// --leaf-functions: a guest function is a leaf region when it can be emitted
+// as one host function entered only at its entry and left only by `jr $ra`:
+// its instructions belong to no other analysed function, it makes no call of
+// any kind (jal/jalr/bal/syscall), writes $ra only through lw (a frame
+// restore), has no computed jr, no j/branch leaves it and none enters it from
+// outside, it does not straddle a unit boundary, and it contains no import
+// stub and no excluded (hand-hooked) PC.  Only jal targets are converted: a
+// leaf nobody calls directly gains nothing.  Everything doubtful is excluded.
+struct LeafRegion {
+    std::uint32_t entry{};
+    std::uint32_t unit{};
+    std::set<std::uint32_t> instructions;   // the function's labels
+    std::set<std::uint32_t> entry_labels;   // its blocks, as the unit had them
+};
+
+struct LeafSelection {
+    std::vector<LeafRegion> regions;
+    std::map<std::string, std::size_t> excluded;  // reason -> count
+    std::size_t candidates{};
+    std::size_t jal_sites{};                       // jal sites that now call a leaf
+};
+
+bool writes_ra_oddly(const psprecomp::DecodedInstruction &d) {
+    using K = psprecomp::OpcodeKind;
+    switch (d.kind) {
+    case K::Lw: case K::Jal: case K::Jalr: case K::Bltzal: case K::Bgezal: case K::Bltzall: case K::Bgezall:
+        return false;
+    case K::Addiu: case K::Lui: case K::Ori: case K::Andi: case K::Xori: case K::Slti: case K::Sltiu:
+    case K::Lh: case K::Lhu: case K::Lb: case K::Lbu: case K::Lwl: case K::Lwr: case K::Mfc1: case K::Mfv:
+    case K::Cfc1: case K::Ext: case K::Ins:
+        return d.rt == 31u;
+    case K::Add: case K::Addu: case K::Sub: case K::Subu: case K::Or: case K::And: case K::Xor: case K::Nor:
+    case K::Sll: case K::Srl: case K::Sra: case K::Rotr: case K::Sllv: case K::Srlv: case K::Srav: case K::Rotrv:
+    case K::Slt: case K::Sltu: case K::Movz: case K::Movn: case K::Mfhi: case K::Mflo: case K::Max: case K::Min:
+    case K::Seb: case K::Seh: case K::Clz: case K::Clo: case K::Bitrev: case K::Wsbh: case K::Wsbw:
+        return d.rd == 31u;
+    default:
+        return false;
+    }
+}
+
+LeafSelection select_leaf_regions(const psprecomp::ProgramAnalysis &program,
+                                  const psprecomp::GuestMemory &memory,
+                                  const std::set<std::uint32_t> &import_stubs,
+                                  const std::set<std::uint32_t> &excluded_pcs,
+                                  const std::set<std::uint32_t> &global_entries,
+                                  const std::set<std::uint32_t> &valid_units,
+                                  std::uint32_t executable_base,
+                                  std::uint32_t unit_span_bytes) {
+    using K = psprecomp::OpcodeKind;
+    LeafSelection selection;
+    const auto &ranges = program.executable_ranges;
+    const auto jump_target = [](std::uint32_t pc, const psprecomp::DecodedInstruction &d) {
+        return ((pc + 4u) & 0xF0000000u) | (d.target << 2u);
+    };
+    const auto branch_target = [](std::uint32_t pc, const psprecomp::DecodedInstruction &d) {
+        return pc + 4u + static_cast<std::uint32_t>(static_cast<std::int32_t>(d.immediate) * 4);
+    };
+
+    // Instructions owned by more than one analysed function, direct call
+    // counts per target, and every j/branch edge in the program by target.
+    std::unordered_map<std::uint32_t, std::uint32_t> owner_count;
+    owner_count.reserve(program.covered_labels.size() * 2u);
+    for (const auto &function : program.functions)
+        for (const auto label : function.labels) ++owner_count[label];
+    std::unordered_map<std::uint32_t, std::size_t> jal_sites_by_target;
+    std::unordered_map<std::uint32_t, std::vector<std::uint32_t>> jump_sources_by_target;
+    for (const auto pc : program.covered_labels) {
+        const auto d = psprecomp::decode_allegrex(memory.load32(pc));
+        if (d.kind == K::Jal) ++jal_sites_by_target[jump_target(pc, d)];
+        else if (d.kind == K::J) jump_sources_by_target[jump_target(pc, d)].push_back(pc);
+        else if (is_branch(d.kind)) jump_sources_by_target[branch_target(pc, d)].push_back(pc);
+    }
+
+    for (const auto &function : program.functions) {
+        if (function.labels.empty()) continue;
+        ++selection.candidates;
+        const auto exclude = [&](const char *reason) { ++selection.excluded[reason]; };
+        if (function.truncated) { exclude("truncated"); continue; }
+        if (jal_sites_by_target[function.entry] == 0u) { exclude("not a jal target"); continue; }
+        if (!global_entries.contains(function.entry)) { exclude("entry not a unit entry"); continue; }
+        bool shared = false;
+        for (const auto label : function.labels) if (owner_count[label] > 1u) { shared = true; break; }
+        if (shared) { exclude("shares instructions with another function"); continue; }
+        const std::uint32_t first = *function.labels.begin();
+        const std::uint32_t last = *function.labels.rbegin();
+        const std::uint32_t unit = (function.entry - executable_base) / unit_span_bytes;
+        if (first < executable_base || (first - executable_base) / unit_span_bytes != unit ||
+            (last + 4u - executable_base) / unit_span_bytes != unit) { exclude("straddles a unit boundary"); continue; }
+        if (!valid_units.contains(unit)) { exclude("unit not emitted"); continue; }
+        bool has_import = false, has_excluded = false;
+        for (const auto label : function.labels) {
+            if (import_stubs.contains(label) || import_stubs.contains(label + 4u)) has_import = true;
+            if (excluded_pcs.contains(label) || excluded_pcs.contains(label + 4u)) has_excluded = true;
+        }
+        if (has_import) { exclude("contains an import stub"); continue; }
+        if (has_excluded) { exclude("contains a hooked PC"); continue; }
+
+        const char *reason = nullptr;
+        for (const auto pc : function.labels) {
+            const auto d = psprecomp::decode_allegrex(memory.load32(pc));
+            psprecomp::DecodedInstruction slot{};
+            const bool delay = d.has_delay_slot();
+            if (delay) slot = psprecomp::decode_allegrex(memory.load32(pc + 4u));
+            if (d.kind == K::Jal || d.kind == K::Jalr || is_link_branch(d.kind)) { reason = "makes a call"; break; }
+            if (d.kind == K::Syscall || (delay && slot.kind == K::Syscall)) { reason = "syscall"; break; }
+            if (d.kind == K::Unsupported || d.kind == K::Vfpu || (delay && (slot.kind == K::Unsupported || slot.kind == K::Vfpu))) {
+                reason = "unsupported instruction"; break;
+            }
+            if (delay && slot.is_control_flow()) { reason = "control flow in delay slot"; break; }
+            if (d.kind == K::Jr && d.rs != 31u) { reason = "computed jr"; break; }
+            if (writes_ra_oddly(d) || (delay && writes_ra_oddly(slot))) { reason = "writes $ra"; break; }
+            if (d.kind == K::J) {
+                if (!function.labels.contains(jump_target(pc, d))) { reason = "j leaves the function"; break; }
+            } else if (is_branch(d.kind)) {
+                const std::uint32_t taken = branch_target(pc, d);
+                const std::uint32_t fallthrough = pc + 8u;
+                if ((psprecomp::is_executable_address(ranges, taken) && !function.labels.contains(taken)) ||
+                    (psprecomp::is_executable_address(ranges, fallthrough) && !function.labels.contains(fallthrough))) {
+                    reason = "branch leaves the function"; break;
+                }
+            } else if (!delay && !d.is_control_flow()) {
+                // Linear flow must stay inside the function (a seed right after
+                // a non-returning path would otherwise be fallen into).
+                const std::uint32_t next = pc + 4u;
+                if (psprecomp::is_executable_address(ranges, next) && !function.labels.contains(next)) {
+                    reason = "falls out of the function"; break;
+                }
+            }
+            if (!delay && d.is_control_flow()) { reason = "unexpected control flow"; break; }
+        }
+        if (reason != nullptr) { exclude(reason); continue; }
+        bool entered_from_outside = false;
+        for (const auto label : function.labels) {
+            const auto sources = jump_sources_by_target.find(label);
+            if (sources == jump_sources_by_target.end()) continue;
+            for (const auto source : sources->second)
+                if (!function.labels.contains(source)) { entered_from_outside = true; break; }
+            if (entered_from_outside) break;
+        }
+        if (entered_from_outside) { exclude("j/branch target from outside"); continue; }
+
+        LeafRegion region;
+        region.entry = function.entry;
+        region.unit = unit;
+        region.instructions = function.labels;
+        for (const auto label : function.labels)
+            if (global_entries.contains(label)) region.entry_labels.insert(label);
+        selection.jal_sites += jal_sites_by_target[function.entry];
+        selection.regions.push_back(std::move(region));
+    }
+    return selection;
+}
