+    // read_vfpu_matrix / write_vfpu_matrix with the slots of the
+    // destination[j * 4 + i] they fill as constants.
+    template <std::uint32_t MatrixRegister, std::uint32_t Side>
+    static constexpr std::array<std::uint8_t, 16> vfpu_matrix_slots = [] {
+        std::array<std::uint8_t, 16> slots{};
+        for (std::uint32_t j = 0u; j < Side; ++j)
+            for (std::uint32_t i = 0u; i < Side; ++i)
+                slots[j * 4u + i] = static_cast<std::uint8_t>(vfpu_matrix_slot<MatrixRegister, Side>(j, i));
+        return slots;
+    }();
+
+    template <std::uint32_t MatrixRegister, std::uint32_t Side>
+    PSPRECOMP_CONTEXT_FORCEINLINE void read_vfpu_matrix_ct(float *destination) const noexcept {
+        static_assert(Side >= 1u && Side <= 4u);
+        constexpr std::array<std::uint8_t, 16> slots = vfpu_matrix_slots<MatrixRegister, Side>;
+        for (std::uint32_t j = 0u; j < Side; ++j)
+            for (std::uint32_t i = 0u; i < Side; ++i) destination[j * 4u + i] = vfpu[slots[j * 4u + i]];
+    }
+
+    template <std::uint32_t MatrixRegister, std::uint32_t Side>
+    PSPRECOMP_CONTEXT_FORCEINLINE void write_vfpu_matrix_ct(const float *source) noexcept {
+        static_assert(Side >= 1u && Side <= 4u);
+        constexpr std::array<std::uint8_t, 16> slots = vfpu_matrix_slots<MatrixRegister, Side>;
+        for (std::uint32_t j = 0u; j < Side; ++j)
+            for (std::uint32_t i = 0u; i < Side; ++i) vfpu[slots[j * 4u + i]] = source[j * 4u + i];
+    }
+
+#if defined(__ARM_NEON)
+    // Lanes 0..Side-1 hold vfpu_matrix[RowIndex * 4 + c], c = 0..Side-1: the
+    // target row vmmul multiplies the source columns by.
+    template <std::uint32_t MatrixRegister, std::uint32_t Side, std::uint32_t RowIndex>
+    [[nodiscard]] PSPRECOMP_CONTEXT_FORCEINLINE float32x4_t vfpu_matrix_row_q() const noexcept {
+        static_assert(Side == 3u || Side == 4u);
+        constexpr std::size_t s0 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 0u);
+        constexpr std::size_t s1 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 1u);
+        constexpr std::size_t s2 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 2u);
+        constexpr std::size_t s3 = Side == 4u ? vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 3u) : s0 + 3u;
+        constexpr bool contiguous = s1 == s0 + 1u && s2 == s0 + 2u && s3 == s0 + 3u;
+        const float *const p = vfpu.data();
+        if constexpr (contiguous && (s0 & 3u) == 0u) {
+            return vld1q_f32(p + s0);
+        } else {
+            float32x4_t v = vld1q_dup_f32(p + s0);
+            v = vld1q_lane_f32(p + s1, v, 1);
+            v = vld1q_lane_f32(p + s2, v, 2);
+            if constexpr (Side == 4u) v = vld1q_lane_f32(p + s3, v, 3);
+            return v;
+        }
+    }
+
+    // Lane c of `value` to vfpu_matrix[RowIndex * 4 + c] (write_vfpu_matrix's slot).
+    template <std::uint32_t MatrixRegister, std::uint32_t Side, std::uint32_t RowIndex>
+    PSPRECOMP_CONTEXT_FORCEINLINE void vfpu_matrix_row_store_q(float32x4_t value) noexcept {
+        static_assert(Side == 3u || Side == 4u);
+        constexpr std::size_t s0 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 0u);
+        constexpr std::size_t s1 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 1u);
+        constexpr std::size_t s2 = vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 2u);
+        constexpr std::size_t s3 = Side == 4u ? vfpu_matrix_slot<MatrixRegister, Side>(RowIndex, 3u) : s0 + 3u;
+        float *const p = vfpu.data();
+        if constexpr (Side == 4u && s1 == s0 + 1u && s2 == s0 + 2u && s3 == s0 + 3u) {
+            vst1q_f32(p + s0, value);
+        } else {
+            vst1q_lane_f32(p + s0, value, 0);
+            vst1q_lane_f32(p + s1, value, 1);
+            vst1q_lane_f32(p + s2, value, 2);
+            if constexpr (Side == 4u) vst1q_lane_f32(p + s3, value, 3);
+        }
+    }
+
+    // Row a of vmmul's result (lanes over b): sum over c of
+    // source column c (lanes over b) * target[a][c].
+    template <std::uint32_t TargetRegister, std::uint32_t Side, std::uint32_t RowIndex>
+    [[nodiscard]] PSPRECOMP_CONTEXT_FORCEINLINE float32x4_t vfpu_vmmul_row_q(
+        float32x4_t c0, float32x4_t c1, float32x4_t c2, float32x4_t c3) const noexcept {
+        const float32x4_t t = vfpu_matrix_row_q<TargetRegister, Side, RowIndex>();
+        float32x4_t sum = vmulq_lane_f32(c0, vget_low_f32(t), 0);
+        sum = vaddq_f32(sum, vmulq_lane_f32(c1, vget_low_f32(t), 1));
+        sum = vaddq_f32(sum, vmulq_lane_f32(c2, vget_high_f32(t), 0));
+        if constexpr (Side == 4u) sum = vaddq_f32(sum, vmulq_lane_f32(c3, vget_high_f32(t), 1));
+        else (void)c3;
+        // The generated loop starts each sum at 0.0f: one final + 0.0f gives the
+        // same bits (see vfpu_vtfm_q).
+        return vaddq_f32(sum, vdupq_n_f32(0.0f));
+    }
