+// Palette checksums per display list. A draw with a paletted texture hashes
+// its palette for the texture cache key; with thousands of draws a frame
+// sharing a few palettes that was ~15% of the GE thread, so each palette is
+// hashed once per list (lists don't rewrite the palettes they draw with).
+struct ClutChecksum {
+    std::uint32_t generation{};
+    std::uint32_t address{};
+    std::uint32_t bytes{};
+    std::uint32_t checksum{};
+};
+std::array<ClutChecksum, 16> g_clut_checksums{};
+std::uint32_t g_clut_generation = 1u;
+
+const std::uint32_t *cached_clut_checksum(std::uint32_t address, std::uint32_t bytes) noexcept {
+    for (const ClutChecksum &entry : g_clut_checksums)
+        if (entry.generation == g_clut_generation && entry.address == address && entry.bytes == bytes)
+            return &entry.checksum;
+    return nullptr;
+}
+
+void remember_clut_checksum(std::uint32_t address, std::uint32_t bytes, std::uint32_t checksum) noexcept {
+    static std::size_t next = 0u;
+    g_clut_checksums[next] = {g_clut_generation, address, bytes, checksum};
+    next = (next + 1u) % g_clut_checksums.size();
+}
+
+}  // namespace
+
+void begin_ge_list() noexcept { ++g_clut_generation; }
