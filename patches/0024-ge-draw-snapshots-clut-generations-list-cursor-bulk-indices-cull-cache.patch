+const HwDrawContext &hw_draw_context(const std::array<std::uint32_t, 256> &commands,
+                                     const GeTransformState &transform,
+                                     const PreparedLighting &lighting,
+                                     bool lighting_prepared,
+                                     std::uint64_t transform_revision,
+                                     std::uint64_t lighting_revision,
+                                     std::uint64_t matrix_revision,
+                                     bool has_vertex_color) {
+    constexpr std::size_t kContexts = 2u * HwDrawQueue::kSlots;
+    static thread_local std::vector<HwDrawContext> ring(kContexts);
+    static thread_local std::size_t index = 0u;
+    HwDrawContext &last = ring[index];
+    if (last.valid && transform_revision != 0u && lighting_revision != 0u && matrix_revision != 0u &&
+        last.transform_revision == transform_revision && last.lighting_revision == lighting_revision &&
+        last.matrix_revision == matrix_revision && last.has_vertex_color == has_vertex_color &&
+        last.lighting_prepared == lighting_prepared)
+        return last;
+    index = (index + 1u) % kContexts;
+    HwDrawContext &next = ring[index];
+    next.commands = commands;
+    next.transform = transform;
+    next.lighting = lighting;
+    next.lighting_prepared = lighting_prepared;
+    next.transform_revision = transform_revision;
+    next.lighting_revision = lighting_revision;
+    next.matrix_revision = matrix_revision;
+    next.has_vertex_color = has_vertex_color;
+    next.valid = true;
