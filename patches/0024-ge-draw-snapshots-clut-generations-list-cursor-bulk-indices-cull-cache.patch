+            stat.vertices += count;
+            return;
+        }
+    }
+    g_layout_stats.push_back({key, 1u, count});
+}
+
+void flush_layout_stats() {
+    if (!layout_stats_enabled() || ++g_layout_stat_lists % 300u != 0u) return;
+    std::sort(g_layout_stats.begin(), g_layout_stats.end(),
+              [](const LayoutStat &a, const LayoutStat &b) { return a.vertices > b.vertices; });
+    for (const LayoutStat &stat : g_layout_stats) {
+        std::fprintf(stderr, "ge-layouts: type %06llx lit %llu path %llu draws %.1f vertices %.0f per list\n",
+                     static_cast<unsigned long long>(stat.key & 0xFFFFFFu),
+                     static_cast<unsigned long long>((stat.key >> 24u) & 1u),
+                     static_cast<unsigned long long>(stat.key >> 25u),
+                     static_cast<double>(stat.draws) / 300.0, static_cast<double>(stat.vertices) / 300.0);
+    }
+    g_layout_stats.clear();
 }
 
