+}
+
+void note_layout_stat(std::uint32_t layout_type, bool lighting_on, std::uint32_t path,
+                      std::uint32_t count) {
+    if (!layout_stats_enabled()) return;
+    const std::uint64_t key = (layout_type & 0xFFFFFFu) |
+        (static_cast<std::uint64_t>(lighting_on) << 24u) | (static_cast<std::uint64_t>(path) << 25u);
+    for (LayoutStat &stat : g_layout_stats) {
+        if (stat.key == key) {
