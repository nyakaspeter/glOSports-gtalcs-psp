+// A PSP strip appended to the group's strip (which starts at first_index):
+// joined by repeating the last and first index (degenerate triangles), plus
+// one more when the group's length is odd so every triangle keeps its winding.
+void append_strip(std::vector<std::uint16_t> &out, const Frame &frame, const Batch &batch, std::uint32_t offset,
+                  std::uint32_t first_index) {
+    const std::uint32_t count = batch.indexed ? batch.index_count : batch.vertex_count;
+    if (count < 3u) return;
+    const std::uint32_t *indices = frame.indices.data() + batch.first_index;
+    const auto index = [&](std::uint32_t i) {
+        return static_cast<std::uint16_t>(offset + (batch.indexed ? indices[i] : i));
+    };
+    const std::size_t length = out.size() - first_index;
+    const std::size_t join = length == 0u ? 0u : (length & 1u) ? 3u : 2u;
+    const std::size_t at = out.size();
+    out.resize(at + join + count);
+    std::uint16_t *dst = out.data() + at;
+    if (join != 0u) {
+        *dst++ = out[at - 1u];
+        *dst++ = index(0u);
+        if (join == 3u) *dst++ = index(0u);
+    }
+    for (std::uint32_t i = 0u; i < count; ++i) dst[i] = index(i);
+}
