+// Game thread: keep this context's ring filled from its current position.
+void atrac_prefetch_request(AtracContextState &state) {
+    const std::uint32_t id = atrac_context_index(state);
+    {
+        std::lock_guard lock(atrac_worker.mutex);
+        if (!atrac_worker.started) {
