+        if (!atrac_worker.started) return;
+        atrac_worker.stop = true;
+        worker = std::move(atrac_worker.thread);
+    }
+    atrac_worker.cv.notify_all();
+    atrac_worker.ready_cv.notify_all();
+    if (worker.joinable()) worker.join();
+    std::lock_guard lock(atrac_worker.mutex);
+    atrac_worker.started = false;
+    atrac_worker.stop = false;
+    atrac_worker.busy_context = -1;
+    atrac_worker.rings = {};
+    atrac_worker.ready_mask.store(0u);
+}
