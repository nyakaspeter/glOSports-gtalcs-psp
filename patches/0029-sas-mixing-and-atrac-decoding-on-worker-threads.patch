+// LCS_SAS_WORKER: __sceSasCore queues the mix and returns; a persistent worker
+// renders it into guest memory (the guest never reads that buffer, it only
+// hands it to sceAudioOutput*, see sas_worker_attach_output) and submits the
+// audio block the game thread attached to the job.  Every other sceSas* call
+// drains the queue first, so the worker owns sas_state while a job is queued.
+struct SasSubmission {
+    std::uint32_t buffer{};
+    std::uint32_t frames{};
+    bool stereo{};
+    std::uint32_t left{};
+    std::uint32_t right{};
+    std::uint32_t channel{};
+    std::uint64_t start_time_us{};
+    std::uint64_t now_us{};
+};
+
+struct SasJob {
+    std::uint32_t output{};
+    std::uint32_t frames{};
+    std::uint32_t mode{};
+    std::uint64_t sequence{};
+    std::vector<SasSubmission> submissions;
+
+    [[nodiscard]] bool covers(std::uint32_t begin, std::uint32_t end) const noexcept {
+        const std::uint32_t job_begin = psprecomp::GuestMemory::canonical(output);
+        const std::uint32_t job_end = job_begin + frames * (mode == 0u ? 4u : 8u);
+        return job_begin < end && begin < job_end;
+    }
+};
+
+constexpr std::size_t kSasMaxQueuedJobs = 8u;
+
+struct SasWorker {
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::thread thread;
+    std::deque<SasJob> jobs;
+    SasJob current;
+    bool busy{};
+    bool stop{};
+    bool started{};
+    std::uint64_t next_sequence{1u};
+    psprecomp::Runtime *runtime{};
+};
+SasWorker sas_worker;
+
+void sas_worker_main() {
+    name_host_thread("lcs-sas");
+    std::vector<std::int16_t> pcm;
+    for (;;) {
+        {
+            std::unique_lock lock(sas_worker.mutex);
+            sas_worker.cv.wait(lock, [] { return sas_worker.stop || !sas_worker.jobs.empty(); });
+            if (sas_worker.jobs.empty()) break;
+            sas_worker.current = std::move(sas_worker.jobs.front());
+            sas_worker.jobs.pop_front();
+            sas_worker.busy = true;
+        }
+        psprecomp::Runtime &rt = *sas_worker.runtime;
+        const SasJob &job = sas_worker.current;
+        if (job.mode == 0u)
+            sas_mix_into(rt, job.output, job.frames);
+        else
+            sas_mix_raw(rt, job.output, job.frames);
+        std::vector<SasSubmission> submissions;
+        {
+            std::lock_guard lock(sas_worker.mutex);
+            submissions.swap(sas_worker.current.submissions);
+            sas_worker.busy = false;
+        }
+        sas_worker.cv.notify_all();
+        for (const SasSubmission &item : submissions) {
+            const std::size_t samples = static_cast<std::size_t>(item.frames) * (item.stereo ? 2u : 1u);
+            const std::uint8_t *raw = rt.memory().raw_pointer(item.buffer, samples * sizeof(std::int16_t));
+            if (raw == nullptr) continue;
+            pcm.resize(samples);
+            std::memcpy(pcm.data(), raw, samples * sizeof(std::int16_t));
+            audio_output_submit(pcm, item.frames, item.stereo, item.left, item.right, 44100u,
+                                item.channel, item.start_time_us, item.now_us);
+        }
     }
