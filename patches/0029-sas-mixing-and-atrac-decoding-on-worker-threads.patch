+
+// Game thread: the next decoded frame, or false while the worker still owes it.
+bool atrac_prefetch_pop(AtracContextState &state, std::span<std::uint8_t> output,
+                        std::size_t &got) {
+    const std::uint32_t id = atrac_context_index(state);
+    const std::uint32_t bit = 1u << id;
+    std::unique_lock lock(atrac_worker.mutex);
+    AtracPrefetchRing &ring = atrac_worker.rings[id];
+    if (ring.count == 0u) {
+        if (!ring.eof) {
+            atrac_worker.ready_mask.fetch_and(~bit);
+            return false;
+        }
+        got = 0u;
+        return true;
+    }
+    got = std::min(ring.sizes[ring.head], output.size());
+    std::memcpy(output.data(), ring.frames[ring.head].data(), got);
+    ring.head = (ring.head + 1u) % kAtracRingFrames;
+    --ring.count;
+    if (ring.count == 0u && !ring.eof) atrac_worker.ready_mask.fetch_and(~bit);
+    lock.unlock();
+    atrac_worker.cv.notify_all();
+    return true;
