+
+void sas_worker_post(psprecomp::Runtime &rt, std::uint32_t output, std::uint32_t frames,
+                     std::uint32_t mode) {
+    {
+        std::unique_lock lock(sas_worker.mutex);
+        if (!sas_worker.started) {
+            sas_worker.started = true;
+            sas_worker.stop = false;
+            sas_worker.runtime = &rt;
+            sas_worker.thread = std::thread(&sas_worker_main);
+        }
+        sas_worker.cv.wait(lock, [] { return sas_worker.jobs.size() < kSasMaxQueuedJobs; });
+        sas_worker.jobs.push_back(SasJob{output, frames, mode, sas_worker.next_sequence++, {}});
+    }
+    sas_worker.cv.notify_all();
+}
+
+void sas_drain() {
+    if (!sas_worker_enabled()) return;
+    std::unique_lock lock(sas_worker.mutex);
+    if (!sas_worker.started) return;
+    sas_worker.cv.wait(lock, [] { return sas_worker.jobs.empty() && !sas_worker.busy; });
+}
+
+void sas_worker_stop() {
+    std::thread worker;
+    {
+        std::lock_guard lock(sas_worker.mutex);
+        if (!sas_worker.started) return;
+        sas_worker.stop = true;
+        worker = std::move(sas_worker.thread);
+    }
+    sas_worker.cv.notify_all();
+    if (worker.joinable()) worker.join();
+    std::lock_guard lock(sas_worker.mutex);
+    sas_worker.started = false;
+    sas_worker.stop = false;
+    sas_worker.busy = false;
+    sas_worker.jobs.clear();
+    sas_worker.current = SasJob{};
+}
+
+struct SasWorkerLifetime {
+    ~SasWorkerLifetime() { sas_worker_stop(); }
+};
+SasWorkerLifetime sas_worker_lifetime;
