+// Game thread, when the guest thread could not be parked: block until the
+// worker has something for this context.
+void atrac_prefetch_wait(std::uint32_t id) {
+    std::unique_lock lock(atrac_worker.mutex);
+    atrac_worker.ready_cv.wait(lock, [id] {
+        return !atrac_worker.started || atrac_worker.stop ||
+            (atrac_worker.ready_mask.load() & (1u << id)) != 0u;
+    });
