 }
 
+bool sas_worker_enabled() {
+    static const bool enabled = [] {
+        const char *text = std::getenv("LCS_SAS_WORKER");
+        return text == nullptr || *text == '\0' || std::strcmp(text, "0") != 0;
+    }();
+    return enabled;
 }
 
+bool sas_worker_attach_output(std::uint32_t buffer, std::uint32_t frames, bool stereo,
+                              std::uint32_t left, std::uint32_t right, std::uint32_t channel,
+                              std::uint64_t start_time_us, std::uint64_t now_us) {
+    if (!sas_worker_enabled()) return false;
+    const std::uint32_t begin = psprecomp::GuestMemory::canonical(buffer);
+    const std::uint32_t end = begin + frames * (stereo ? 4u : 2u);
+    std::lock_guard lock(sas_worker.mutex);
+    if (!sas_worker.started) return false;
+    // The last overlapping job completes last; the earlier ones are already
+    // mixed by then, the worker runs them in order.
+    SasJob *target = nullptr;
+    for (auto it = sas_worker.jobs.rbegin(); it != sas_worker.jobs.rend() && target == nullptr; ++it)
+        if (it->covers(begin, end)) target = &*it;
+    if (target == nullptr && sas_worker.busy && sas_worker.current.covers(begin, end))
+        target = &sas_worker.current;
+    if (target == nullptr) return false;
+    target->submissions.push_back(SasSubmission{buffer, frames, stereo, left, right, channel,
+                                                start_time_us, now_us});
+    return true;
+}
+
+void sas_worker_shutdown() {
+    sas_worker_stop();
+}
