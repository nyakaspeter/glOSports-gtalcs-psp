+// Game thread: stop decoding this context and drop its frames.  The caller
+// then closes the decoder, which the worker no longer touches.
+void atrac_prefetch_close(AtracContextState &state) {
+    const std::uint32_t id = atrac_context_index(state);
+    std::unique_lock lock(atrac_worker.mutex);
+    AtracPrefetchRing &ring = atrac_worker.rings[id];
+    ring.wanted = false;
+    atrac_worker.cv.wait(lock, [id] { return atrac_worker.busy_context != static_cast<int>(id); });
+    ring.head = 0u;
+    ring.count = 0u;
+    ring.eof = false;
+    // A thread parked on this context re-runs its decode step against the
+    // reset state (atrac_poll_guest_waits).
+    if ((atrac_wait_mask & (1u << id)) != 0u) atrac_worker.ready_mask.fetch_or(1u << id);
