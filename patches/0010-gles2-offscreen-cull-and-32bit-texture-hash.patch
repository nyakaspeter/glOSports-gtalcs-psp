+// LCS_GLES_CULL=0: keep draws that are entirely off screen. GTA culls whole
+// objects; the meshes of a partly visible one all arrive here, and every one
+// costs the GE thread, a GL draw and vertex shading. A mesh whose model-space
+// bounding box is outside one clip plane draws nothing.
+bool cull_enabled() {
+    static const bool enabled = [] {
+        const char *text = std::getenv("LCS_GLES_CULL");
+        return text == nullptr || *text == '\0' || std::strcmp(text, "0") != 0;
+    }();
+    return enabled;
+}
+
+bool off_screen(const Gles2State &s, const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &hw,
+                const std::array<float, 3> &low, const std::array<float, 3> &high) {
+    std::uint32_t width = kReferenceWidth;
+    std::uint32_t height = kReferenceHeight;
+    if (const auto found = s.targets.find(draw.framebuffer_address & 0x001FFFF0u); found != s.targets.end()) {
+        width = std::max<std::uint32_t>(1u, found->second.logical_width);
+        height = std::max<std::uint32_t>(1u, found->second.logical_height);
+    }
+    const ClipRows rows = clip_rows(hw, width, height);
+    // Outside when all 8 corners are on the far side of one plane:
+    // w + x, w - x, w + y, w - y >= 0 and (depth clip) z >= 0, w - z >= 0.
+    std::uint32_t outside = 0x3Fu;
+    for (std::uint32_t corner = 0u; corner < 8u && outside != 0u; ++corner) {
+        const float p[4] = {(corner & 1u) ? high[0] : low[0], (corner & 2u) ? high[1] : low[1],
+                            (corner & 4u) ? high[2] : low[2], 1.0f};
+        const auto dot = [&](const std::array<float, 4> &row) {
+            return row[0] * p[0] + row[1] * p[1] + row[2] * p[2] + row[3] * p[3];
+        };
+        const float x = dot(rows[0]), y = dot(rows[1]), z = dot(rows[2]), w = dot(rows[3]);
+        std::uint32_t mask = 0u;
+        if (w + x < 0.0f) mask |= 1u;
+        if (w - x < 0.0f) mask |= 2u;
+        if (w + y < 0.0f) mask |= 4u;
+        if (w - y < 0.0f) mask |= 8u;
+        if (hw.depth_clip_enabled && z < 0.0f) mask |= 16u;
+        if (hw.depth_clip_enabled && w - z < 0.0f) mask |= 32u;
+        outside &= mask;
+    }
+    return outside != 0u;
+}
