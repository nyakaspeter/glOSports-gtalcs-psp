+// run-time-prefixed form, which resets them. vfpu_ctrl[0..2] therefore hold
+// the defaults between instructions, which is what the run-time forms assume.
+struct PrefixState {
+    static constexpr std::uint32_t kDefaultSource = 0xE4u;
+    std::uint32_t s{kDefaultSource};
+    std::uint32_t t{kDefaultSource};
+    std::uint32_t d{0u};
+    bool enabled{true};
+    [[nodiscard]] bool defaults() const noexcept { return s == kDefaultSource && t == kDefaultSource && d == 0u; }
+    [[nodiscard]] bool pending() const noexcept { return !defaults(); }
+    void reset() noexcept { s = kDefaultSource; t = kDefaultSource; d = 0u; }
+    // The stores a run-time-prefixed consumer needs before it runs.
+    [[nodiscard]] std::string materialize() const {
+        std::string out;
+        if (s != kDefaultSource) out += "    ctx.vfpu_ctrl[0u] = " + psprecomp::hex32(s) + "u;\n";
+        if (t != kDefaultSource) out += "    ctx.vfpu_ctrl[1u] = " + psprecomp::hex32(t) + "u;\n";
+        if (d != 0u) out += "    ctx.vfpu_ctrl[2u] = " + psprecomp::hex32(d) + "u;\n";
+        return out;
+    }
