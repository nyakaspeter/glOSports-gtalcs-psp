+// True when every `vpfx` in the program is consumed by a VFPU instruction in
+// its own basic block, so the generator can fold prefixes at compile time.
+// A prefix that survives a block boundary (none seen in practice) would need
+// the run-time vfpu_ctrl forms everywhere, so one such site disables folding.
+bool prefixes_fold_safely(const psprecomp::GuestMemory &memory,
+                          const std::set<std::uint32_t> &instructions,
+                          const std::set<std::uint32_t> &entry_labels,
+                          std::uint32_t &offending_pc) {
+    for (const auto block_start : entry_labels) {
+        bool pending = false;
+        std::uint32_t pending_pc = 0u;
+        std::uint32_t pc = block_start;
+        auto note = [&](const psprecomp::DecodedInstruction &d, std::uint32_t at) {
+            if (d.kind == psprecomp::OpcodeKind::Vpfx) { pending = true; pending_pc = at; }
+            else if (consumes_vfpu_prefixes(d.kind)) pending = false;
+            else if (d.kind == psprecomp::OpcodeKind::Vflush && (d.word & 0xFFFF0000u) != 0xFFFF0000u) pending = false;
+        };
+        while (instructions.contains(pc)) {
+            if (pc != block_start && entry_labels.contains(pc)) break;
+            const auto decoded = psprecomp::decode_allegrex(memory.load32(pc));
+            note(decoded, pc);
+            if (decoded.has_delay_slot()) {
+                const auto slot = psprecomp::decode_allegrex(memory.load32(pc + 4u));
+                note(slot, pc + 4u);
+                break;
+            }
+            pc += 4u;
+        }
+        if (pending) { offending_pc = pending_pc; return false; }
+    }
+    return true;
+}
 
