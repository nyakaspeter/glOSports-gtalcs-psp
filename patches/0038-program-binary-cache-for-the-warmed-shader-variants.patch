+// LCS_GLES_SHADER_CACHE: the driver's linked program binary, saved after the
+// first compile and loaded instead of compiling from then on. The file
+// carries a hash of the shader sources and the driver strings: a changed
+// shader or driver misses (and is overwritten); a binary the driver rejects
+// falls back to the compiler.
+struct ProgramBinaryHeader {
+    char magic[4];
+    std::uint32_t format;
+    std::uint32_t length;
+    std::uint32_t reserved;
+    std::uint64_t source_hash;
+};
+
+std::uint64_t fnv1a(std::uint64_t hash, const char *text) noexcept {
+    for (; text != nullptr && *text != '\0'; ++text) {
+        hash ^= static_cast<unsigned char>(*text);
+        hash *= 0x100000001B3ull;
+    }
+    return hash;
+}
+
+std::string program_binary_path(const RenderState &r, std::uint64_t key) {
+    char name[32];
+    std::snprintf(name, sizeof(name), "%016llx.bin", static_cast<unsigned long long>(key));
+    return r.shader_cache_directory + '/' + name;
+}
+
+bool load_program_binary(RenderState &r, std::uint64_t key, Program &program) {
+    if (r.program_binary == nullptr) return false;
+    std::ifstream input(program_binary_path(r, key), std::ios::binary);
+    if (!input) return false;
+    ProgramBinaryHeader header{};
+    if (!input.read(reinterpret_cast<char *>(&header), sizeof(header)) ||
+        std::memcmp(header.magic, "LCSB", 4) != 0 || header.source_hash != r.shader_source_hash ||
+        header.length == 0u || header.length > (16u << 20u))
+        return false;
+    std::vector<char> data(header.length);
+    if (!input.read(data.data(), static_cast<std::streamsize>(data.size()))) return false;
+    program.id = glCreateProgram();
+    r.program_binary(program.id, static_cast<GLenum>(header.format), data.data(),
+                     static_cast<GLint>(data.size()));
+    GLint ok = GL_FALSE;
+    glGetProgramiv(program.id, GL_LINK_STATUS, &ok);
+    while (glGetError() != GL_NO_ERROR) {}
+    if (ok != GL_TRUE) {
+        glDeleteProgram(program.id);
+        program.id = 0u;
+        return false;
+    }
+    finish_program(program);
+    ++r.cache_loaded;
+    return true;
+}
+
+void save_program_binary(RenderState &r, std::uint64_t key, const Program &program) {
+    if (r.get_program_binary == nullptr) return;
+    GLint length = 0;
+    glGetProgramiv(program.id, GL_PROGRAM_BINARY_LENGTH_OES, &length);
+    if (length <= 0) return;
+    std::vector<char> data(static_cast<std::size_t>(length));
+    GLsizei written = 0;
+    GLenum format = 0u;
+    r.get_program_binary(program.id, length, &written, &format, data.data());
+    if (glGetError() != GL_NO_ERROR || written <= 0) return;
+    ProgramBinaryHeader header{{'L', 'C', 'S', 'B'}, static_cast<std::uint32_t>(format),
+                               static_cast<std::uint32_t>(written), 0u, r.shader_source_hash};
+    const std::string path = program_binary_path(r, key);
+    const std::string temporary = path + ".tmp";
+    {
+        std::ofstream output(temporary, std::ios::binary | std::ios::trunc);
+        if (!output) return;
+        output.write(reinterpret_cast<const char *>(&header), sizeof(header));
+        output.write(data.data(), written);
+        if (!output) return;
+    }
+    if (std::rename(temporary.c_str(), path.c_str()) == 0) ++r.cache_saved;
 }
 
