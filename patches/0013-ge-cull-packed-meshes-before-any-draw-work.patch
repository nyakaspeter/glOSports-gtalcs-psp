+// Called by the GE renderer before any other work on the draw (so the packed
+// path in accumulate below doesn't test again).
+bool ge_gpu_backend_packed_0115_off_screen(const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+                                           std::span<const std::byte> packed_vertices) noexcept {
+    if (!cull_enabled() || draw.clear_mode || packed_vertices.size() < sizeof(Packed0115)) return false;
+    const auto *bytes = reinterpret_cast<const std::uint8_t *>(packed_vertices.data());
+    const std::size_t count = packed_vertices.size() / sizeof(Packed0115);
+    std::int16_t low[3] = {INT16_MAX, INT16_MAX, INT16_MAX};
+    std::int16_t high[3] = {INT16_MIN, INT16_MIN, INT16_MIN};
+    for (std::size_t i = 0u; i < count; ++i) {
+        std::int16_t p[3];
+        std::memcpy(p, bytes + i * sizeof(Packed0115) + 4u, sizeof(p));
+        for (int c = 0; c < 3; ++c) {
+            low[c] = std::min(low[c], p[c]);
+            high[c] = std::max(high[c], p[c]);
+        }
+    }
+    constexpr float k = 1.0f / 32768.0f;
+    Gles2State &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled ||
+        !off_screen(s, draw, transform, {low[0] * k, low[1] * k, low[2] * k}, {high[0] * k, high[1] * k, high[2] * k}))
+        return false;
+    ++s.culled_draws;
+    s.culled_vertices += count;
+    return true;
+}
