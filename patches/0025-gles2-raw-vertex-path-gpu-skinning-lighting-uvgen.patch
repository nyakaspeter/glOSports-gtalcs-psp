+// Model-space bounds of raw vertices (positions of any type), for the GE-side
+// cull: scalar, over the positions only.
+bool raw_position_bounds(const std::uint8_t *raw, std::size_t count, std::uint32_t stride,
+                         std::uint32_t offset, std::uint32_t type,
+                         std::array<float, 3> &low, std::array<float, 3> &high) noexcept {
+    if (count == 0u || type == 0u) return false;
+    low = {INFINITY, INFINITY, INFINITY};
+    high = {-INFINITY, -INFINITY, -INFINITY};
+    const std::uint8_t *p = raw + offset;
+    if (type == 2u) {
+        std::int16_t lo[3] = {INT16_MAX, INT16_MAX, INT16_MAX};
+        std::int16_t hi[3] = {INT16_MIN, INT16_MIN, INT16_MIN};
+        for (std::size_t i = 0u; i < count; ++i, p += stride) {
+            std::int16_t v[3];
+            std::memcpy(v, p, sizeof(v));
+            for (int c = 0; c < 3; ++c) {
+                lo[c] = std::min(lo[c], v[c]);
+                hi[c] = std::max(hi[c], v[c]);
+            }
+        }
+        for (int c = 0; c < 3; ++c) {
+            low[c] = lo[c] * (1.0f / 32768.0f);
+            high[c] = hi[c] * (1.0f / 32768.0f);
+        }
+        return true;
+    }
+    if (type == 1u) {
+        std::int8_t lo[3] = {INT8_MAX, INT8_MAX, INT8_MAX};
+        std::int8_t hi[3] = {INT8_MIN, INT8_MIN, INT8_MIN};
+        for (std::size_t i = 0u; i < count; ++i, p += stride) {
+            for (int c = 0; c < 3; ++c) {
+                const std::int8_t v = static_cast<std::int8_t>(p[c]);
+                lo[c] = std::min(lo[c], v);
+                hi[c] = std::max(hi[c], v);
+            }
+        }
+        for (int c = 0; c < 3; ++c) {
+            low[c] = lo[c] * (1.0f / 128.0f);
+            high[c] = hi[c] * (1.0f / 128.0f);
+        }
+        return true;
+    }
+    for (std::size_t i = 0u; i < count; ++i, p += stride) {
+        float v[3];
+        std::memcpy(v, p, sizeof(v));
+        for (int c = 0; c < 3; ++c) {
+            if (!std::isfinite(v[c])) return false;
+            low[c] = std::min(low[c], v[c]);
+            high[c] = std::max(high[c], v[c]);
+        }
+    }
+    return true;
+}
