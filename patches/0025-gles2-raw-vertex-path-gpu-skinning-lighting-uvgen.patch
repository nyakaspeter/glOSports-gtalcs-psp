+// The raw path's uniform block (see GeGpuRawState): matrices as rows so the
+// shader transforms with dot products, the prepared lighting as is.
+void fill_raw_state(GeGpuRawState &out, GeGpuRawLayout &variant, const GeTransformState &transform,
+                    const PreparedLighting &lighting, bool lighting_on,
+                    const std::array<std::uint32_t, 256> &commands) noexcept {
+    auto &u = out.uniforms;
+    const auto rows = [&](std::size_t first, const float *m) {
+        for (std::size_t r = 0u; r < 3u; ++r) u[first + r] = {m[r], m[3u + r], m[6u + r], m[9u + r]};
+    };
+    rows(0u, transform.world.data());
+    rows(3u, transform.texture.data());
+    u[6] = {lighting.material_ambient.r, lighting.material_ambient.g, lighting.material_ambient.b,
+            lighting.material_ambient.a};
+    u[7] = {lighting.material_diffuse.r, lighting.material_diffuse.g, lighting.material_diffuse.b, 0.0f};
+    u[8] = {lighting.material_specular.r, lighting.material_specular.g, lighting.material_specular.b, 0.0f};
+    u[9] = {lighting.emissive.r, lighting.emissive.g, lighting.emissive.b, 0.0f};
+    u[10] = {lighting.global_ambient.r, lighting.global_ambient.g, lighting.global_ambient.b,
+             lighting.global_ambient.a};
+    u[11] = {lighting.specular_exponent, static_cast<float>(lighting.material_update),
+             (data24(commands[0x51u]) & 1u) != 0u ? -1.0f : 1.0f, lighting_on ? 1.0f : 0.0f};
+    const Color constant = material_ambient_color(commands);
+    u[12] = {constant.r / 255.0f, constant.g / 255.0f, constant.b / 255.0f, constant.a / 255.0f};
+    const std::uint32_t shade = data24(commands[0xC1u]);
+    const std::uint32_t uv_mode = data24(commands[0xC0u]);
+    u[13] = {static_cast<float>(uv_mode & 3u), static_cast<float>(shade & 3u),
+             static_cast<float>((shade >> 8u) & 3u), static_cast<float>((uv_mode >> 8u) & 3u)};
+    const auto light_vector = [&](std::uint32_t light) {
+        return normalized_or_001(Vec3{
+            decode_float24(data24(commands[0x63u + light * 3u])),
+            decode_float24(data24(commands[0x64u + light * 3u])),
+            decode_float24(data24(commands[0x65u + light * 3u])),
+        });
+    };
+    const Vec3 shade_s = light_vector(shade & 3u);
+    const Vec3 shade_t = light_vector((shade >> 8u) & 3u);
+    u[62] = {shade_s.x, shade_s.y, shade_s.z, 0.0f};
+    u[63] = {shade_t.x, shade_t.y, shade_t.z, 0.0f};
+    variant.lights = 0u;
+    variant.light_point = variant.light_spot = variant.light_specular = variant.light_pow = false;
+    for (std::size_t i = 0u; i < 4u; ++i) {
+        const PreparedLight &light = lighting.lights[i];
+        if (!lighting_on || !lighting.enabled || !light.enabled) continue;
+        const std::size_t base = kGeGpuRawLightBase + variant.lights * 6u;
+        ++variant.lights;
+        variant.light_point |= light.type != 0u;
+        variant.light_spot |= light.type >= 2u;
+        variant.light_specular |= light.computation == 1u;
+        variant.light_pow |= light.computation == 2u;
+        u[base] = {light.vector.x, light.vector.y, light.vector.z, static_cast<float>(light.type)};
+        u[base + 1u] = {light.attenuation.x, light.attenuation.y, light.attenuation.z,
+                        static_cast<float>(light.computation)};
+        u[base + 2u] = {light.spot_direction.x, light.spot_direction.y, light.spot_direction.z, light.cutoff};
+        u[base + 3u] = {light.ambient.r, light.ambient.g, light.ambient.b, light.exponent};
+        u[base + 4u] = {light.diffuse.r, light.diffuse.g, light.diffuse.b,
+                        lighting.enabled && light.enabled ? 1.0f : 0.0f};
+        u[base + 5u] = {light.specular.r, light.specular.g, light.specular.b, 0.0f};
+    }
+    for (std::size_t bone = 0u; bone < 8u; ++bone)
+        rows(kGeGpuRawBoneBase + bone * 3u, transform.bones.data() + bone * 12u);
+}
