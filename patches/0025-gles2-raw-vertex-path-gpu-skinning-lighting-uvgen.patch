+// Bounds per (address, size), kept while the vertex pages are unwritten (the
+// guest memory's page generations); a scan of the positions otherwise.
+struct CachedBounds {
+    std::uint32_t address{};
+    std::uint32_t bytes{};
+    std::uint64_t pages{};
+    std::array<float, 3> low{};
+    std::array<float, 3> high{};
+    bool valid{};
+};
+
+template <typename Scan>
+const CachedBounds &cached_bounds(const psprecomp::GuestMemory &memory, std::uint32_t address,
+                                  std::size_t bytes, Scan scan) {
+    static thread_local std::array<CachedBounds, 4096> cache{};
+    CachedBounds &slot = cache[((address >> 4u) ^ (address >> 16u) ^ static_cast<std::uint32_t>(bytes)) & 4095u];
+    const std::uint64_t pages = memory.range_generation(address, bytes);
+    if (!slot.valid || slot.address != address || slot.bytes != bytes || slot.pages != pages) {
+        slot.valid = scan(slot.low, slot.high);
+        slot.address = address;
+        slot.bytes = static_cast<std::uint32_t>(bytes);
+        slot.pages = pages;
+    }
+    return slot;
+}
