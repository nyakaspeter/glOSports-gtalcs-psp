+// Display-list words straight from main RAM (a list is thousands of words a
+// frame); anything outside it through the checked accessors.
+struct ListReader {
+    const psprecomp::GuestMemory &memory;
+    const std::uint8_t *ram;
+    std::uint32_t ram_size;
+
+    explicit ListReader(const psprecomp::GuestMemory &m)
+        : memory(m), ram(m.raw_pointer(psprecomp::GuestMemory::kPhysicalBase, m.size())), ram_size(m.size()) {}
+
+    bool fetch(std::uint32_t address, std::uint32_t &word) const {
+        const std::uint32_t offset = (address & 0x1FFFFFFFu) - psprecomp::GuestMemory::kPhysicalBase;
+        if (ram != nullptr && ram_size >= 4u && offset <= ram_size - 4u) {
+            std::memcpy(&word, ram + offset, sizeof(word));
+            return true;
+        }
+        if (!memory.contains(address, 4u)) return false;
+        word = memory.load32(address);
+        return true;
+    }
+};
+
 }  // namespace
 
