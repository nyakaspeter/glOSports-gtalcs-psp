+// A stick as a direction and a deflection: the dead zone is on the
+// deflection (radial), so a small push keeps its angle. stick_to_psp's
+// per-axis dead zone (24% of each axis) zeroed the smaller component of
+// any push near an axis, which turned the stick into eight directions
+// (GA36-MB, 2026-10-30). Outputs -127..127 each.
+inline void stick_radial(std::int16_t raw_x, std::int16_t raw_y, int &out_x, int &out_y) noexcept {
+    constexpr float kDeadZone = 0.20f;  // of full deflection; the GA36-MB rests up to 8% off centre
+    const float x = static_cast<float>(raw_x) / 32767.0f;
+    const float y = static_cast<float>(raw_y) / 32767.0f;
+    const float deflection = std::sqrt(x * x + y * y);
+    if (deflection <= kDeadZone) {
+        out_x = out_y = 0;
+        return;
+    }
+    const float scale = std::min(1.0f, (deflection - kDeadZone) / (1.0f - kDeadZone)) / deflection;
+    out_x = std::clamp(static_cast<int>(std::lround(x * scale * 127.0f)), -127, 127);
+    out_y = std::clamp(static_cast<int>(std::lround(y * scale * 127.0f)), -127, 127);
 }
 
