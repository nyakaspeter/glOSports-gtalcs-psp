+                        *dst++ = palette[texture.pixels[source_offset(x)]];
+                }
+            }
+            return;
+        }
+        std::uint16_t *dst = dst16 + static_cast<std::size_t>(first_row) * texture.width;
+        for (std::uint32_t y = first_row; y <= last_row; ++y)
