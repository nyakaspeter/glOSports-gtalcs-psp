+// formats have a direct path for CLUT4/CLUT8 textures (the palette packed once,
+// one 16-bit store per texel); everything else goes through the generic
+// sampler.
+bool decode_texture_into(const psprecomp::GuestMemory &memory, const TextureSetup &texture,
+                         std::span<std::byte> out, GeGpuTexelFormat format) {
+    if (format == GeGpuTexelFormat::Rgba8) return decode_texture_rgba_into(memory, texture, out);
+    if (texture.format > 10u || texture.width == 0u || texture.height == 0u ||
+        texture.width > 2048u || texture.height > 2048u) return false;
+    if (static_cast<std::uint64_t>(texture.width) * texture.height * 2ull != out.size()) return false;
+    std::uint16_t *const dst16 = reinterpret_cast<std::uint16_t *>(out.data());
 
+    const bool clut4 = texture.format == 4u;
+    const bool clut8 = texture.format == 5u;
+    const bool fast_clut = (clut4 || clut8) && texture.pixels != nullptr;
+    std::array<std::uint16_t, 256> palette{};
+    if (fast_clut) {
+        const std::uint32_t entries = clut4 ? 16u : 256u;
+        for (std::uint32_t i = 0u; i < entries; ++i)
+            palette[i] = pack_gl16(read_clut_fast(memory, texture, i), format);
+    }
+
+    auto decode_rows = [&](std::uint32_t first_row, std::uint32_t last_row) {
+        if (fast_clut) {
+            const std::uint32_t row_bytes = clut4 ? (texture.buffer_width + 1u) >> 1u : texture.buffer_width;
+            const std::uint32_t blocks_per_row = (row_bytes + 15u) >> 4u;
+            for (std::uint32_t y = first_row; y <= last_row; ++y) {
+                std::uint16_t *dst = dst16 + static_cast<std::size_t>(y) * texture.width;
+                const auto source_offset = [&](std::uint32_t byte_x) noexcept {
+                    if (!texture.swizzled)
+                        return static_cast<std::size_t>(y) * row_bytes + byte_x;
+                    return static_cast<std::size_t>(
+                        (((y >> 3u) * blocks_per_row + (byte_x >> 4u)) << 7u) +
+                        ((y & 7u) << 4u) + (byte_x & 15u));
+                };
+                if (clut4) {
+                    for (std::uint32_t x = 0u; x < texture.width; x += 2u) {
+                        const std::uint8_t packed = texture.pixels[source_offset(x >> 1u)];
+                        *dst++ = palette[packed & 0x0Fu];
+                        if (x + 1u < texture.width) *dst++ = palette[packed >> 4u];
+                    }
+                } else {
