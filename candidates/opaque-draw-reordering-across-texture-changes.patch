+// ------------------------------------------------------------- reordering --
+//
+// LCS_GLES_REORDER (default 1). Merging in stream order joins a draw to the
+// GL draw before it only; the world arrives object by object, so textures
+// alternate and most draws break the merge (~700 texture breaks a street
+// frame). Here a draw may also join an older one of the last few open GL
+// draws (groups) with its state, which moves it ahead of the draws in the
+// groups opened after that one. Groups go out in the order they opened. That
+// is exact only when the draw commutes with each draw it passes; draws X then
+// B commute here when, from their model-space boxes (GeGpuHardwareTransform::
+// bounds_*) projected to the window with all 8 corners in front of the eye
+// (the projected box bounds every fragment the draw can produce):
+//  1. their screen rectangles are apart: no pixel in common, so any state; or
+//  2. both are depth-opaque, with the same direction and colour mask (see
+//     depth_opaque_class), and their depth ranges are apart: at a pixel the
+//     nearer fragment wins whichever goes first and the two cannot tie. Alpha
+//     test (discard), culling, fog and texturing act per fragment, the same in
+//     either order. Ties are where order shows among depth-opaque draws (a
+//     decal coplanar with its wall: LEQUAL lets the later one win, LESS the
+//     earlier one); disjoint depth ranges rule them out, so this needs no
+//     decal heuristic and LEQUAL is no riskier than LESS.
+// Margins cover rasterisation and depth quantisation (16-bit depth: 8 steps).
+// Anything else blocks: a draw with no box (skinned, through mode, clear
+// mode, crossing the eye plane), blending against an overlapping draw, other
+// depth functions. A target change or a draw sampling its own target emits
+// every open group (a barrier). LCS_GLES_REORDER=2 adds a heuristic, for
+// measuring only: depth-opaque draws also commute when neither has 16
+// vertices or fewer (decal-sized), trusting the depth test with ties.
+//
+// Index building: each open group keeps its own indices (copied to
+// frame.index16 when it goes out), offsets from its own base with the raw
+// stride rule and the 65,536-vertex limit (fits_group) checked per group. A
+// moved draw always joins by indices: it never extends a strip run
+// (Batch::strip_run), which needs the batch just before it in the stream.
+// The Mali-400 vertex processor shades every vertex between a draw's lowest
+// and highest index, so a moved draw may skip at most reorder_gap vertices
+// past the group's last (LCS_GLES_REORDER_GAP, default 256).
+
+constexpr std::uint32_t kMaxReorderGroups = 16u;
+constexpr std::uint32_t kReorderSmallVertices = 16u;  // LCS_GLES_REORDER=2: decal-sized
+constexpr std::size_t kReorderMemberChecks = 16u;     // per-draw tests when a group's union overlaps
+constexpr float kReorderXyMargin = 0.02f;             // NDC: ~5 pixels at 480, ~4 at 360
+constexpr float kReorderDepthMargin = 1.0f / 8192.0f;  // window depth: 8 steps of 16-bit depth
+
+// Window-space bounds: x and y in NDC of the logical target, z the window
+// depth (z/w, see the vertex shader: [0, w] mapped to GL's [-w, w]).
+struct WindowBox {
+    float x0{}, y0{}, z0{};
+    float x1{}, y1{}, z1{};
+};
+
+bool window_box(const Batch &batch, std::uint32_t logical_width, std::uint32_t logical_height, WindowBox &box) {
+    const GeGpuHardwareTransform &hw = batch.transform;
+    if (!batch.hardware_transform || !hw.bounds_valid || batch.draw.clear_mode) return false;
+    const ClipRows rows = clip_rows(hw, logical_width, logical_height);
+    box = {INFINITY, INFINITY, INFINITY, -INFINITY, -INFINITY, -INFINITY};
+    for (std::uint32_t corner = 0u; corner < 8u; ++corner) {
+        const float p[3] = {(corner & 1u) ? hw.bounds_high[0] : hw.bounds_low[0],
+                            (corner & 2u) ? hw.bounds_high[1] : hw.bounds_low[1],
+                            (corner & 4u) ? hw.bounds_high[2] : hw.bounds_low[2]};
+        const auto dot = [&](const std::array<float, 4> &row) {
+            return row[0] * p[0] + row[1] * p[1] + row[2] * p[2] + row[3];
+        };
+        // w is affine in the model position: positive at the corners, positive
+        // inside, and the projected box is convex with its extremes at them.
+        const float w = dot(rows[3]);
+        if (!(w > 1.0e-6f)) return false;
+        float z = dot(rows[2]);
+        if (!hw.depth_clip_enabled) z = std::clamp(z, 0.0f, w);  // as the shader
+        const float inverse = 1.0f / w;
+        const float x = dot(rows[0]) * inverse;
+        const float y = dot(rows[1]) * inverse;
+        z *= inverse;
+        box.x0 = std::min(box.x0, x);
+        box.x1 = std::max(box.x1, x);
+        box.y0 = std::min(box.y0, y);
+        box.y1 = std::max(box.y1, y);
+        box.z0 = std::min(box.z0, z);
+        box.z1 = std::max(box.z1, z);
+    }
+    return std::isfinite(box.x0) && std::isfinite(box.x1) && std::isfinite(box.y0) && std::isfinite(box.y1) &&
+           std::isfinite(box.z0) && std::isfinite(box.z1);
+}
+
+bool apart(float a0, float a1, float b0, float b1, float margin) {
+    return a1 + margin < b0 || b1 + margin < a0;
+}
+
+bool boxes_commute(const WindowBox &a, const WindowBox &b, bool depth_opaque) {
+    return apart(a.x0, a.x1, b.x0, b.x1, kReorderXyMargin) || apart(a.y0, a.y1, b.y0, b.y1, kReorderXyMargin) ||
+           (depth_opaque && apart(a.z0, a.z1, b.z0, b.z1, kReorderDepthMargin));
+}
+
+// Depth-opaque: depth test LESS/LEQUAL (1) or GREATER/GEQUAL (2) with depth
+// write on and GL blending off (blend variants 0 and 2), with the colour mask
+// above (two draws commute by depth only with the same mask: a fragment that
+// wins the depth test but leaves a channel alone would keep the loser's
+// colour in one order and the old one in the other). 0: none of that.
+std::uint32_t depth_opaque_class(std::uint32_t fixed) {
+    if ((fixed & kFixedDepthTest) == 0u || (fixed & kFixedDepthWrite) == 0u) return 0u;
+    const std::uint32_t blend = (fixed >> kFixedBlendShift) & 7u;
+    if (blend != 0u && blend != 2u) return 0u;
+    const std::uint32_t function = (fixed >> kFixedDepthFuncShift) & 7u;
+    const std::uint32_t direction = function == 4u || function == 5u ? 1u : function == 6u || function == 7u ? 2u : 0u;
+    if (direction == 0u) return 0u;
+    return direction | (((fixed >> kFixedMaskShift) & 15u) << 2u);
+}
