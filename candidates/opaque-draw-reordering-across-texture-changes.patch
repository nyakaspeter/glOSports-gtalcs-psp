+struct ReorderMember {
+    std::uint32_t batch{};
+    std::uint8_t box_state{};  // 0 not projected yet, 1 box, 2 none
+    WindowBox box{};
+};
+
+// An open group: a GL draw still taking draws.
+struct ReorderGroup {
+    Command command{};                  // state, base, strip; the rest when it goes out
+    Index16Vector indices;              // its indices, from its base
+    std::uint32_t run_count{};          // as merge_frame_in_order's (a strip run)
+    const Batch *previous{};            // the batch last added
+    std::uint32_t vertex_end{};         // past its highest vertex, from its base
+    std::uint32_t depth_class{};        // depth_opaque_class of its state
+    bool has_small{};                   // has a decal-sized draw (LCS_GLES_REORDER=2)
+    std::vector<ReorderMember> members;
+    std::size_t union_count{};          // members in union_box
+    bool union_valid{true};             // false: a member has no box
+    WindowBox union_box{};
+};
