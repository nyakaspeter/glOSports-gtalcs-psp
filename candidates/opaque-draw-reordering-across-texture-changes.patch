+void merge_frame_reorder(const MergeSettings &m, Frame &frame) {
+    std::vector<Command> &commands = frame.commands;
+    Index16Vector &index16 = frame.index16;
+    commands.clear();
+    index16.clear();
+    frame.breaks = {};
+    frame.reorder = {};
+    frame.touched_display = false;
+    frame.merged = true;
+    if (frame.batches.empty()) return;
+    // Frame::reorder: groups opened, draws joined out of order, blocked (an
+    // older group had the state but a draw between overlaps), gap (too many
+    // vertices between), evicted (the oldest group out to open another),
+    // barriers (all out: target change, feedback), boxes projected.
+    std::array<std::uint64_t, 16> &count = frame.reorder;
+    static thread_local std::array<ReorderGroup, kMaxReorderGroups> slots;
+    std::array<std::uint32_t, kMaxReorderGroups> order{};  // the open groups' slots, oldest first
